PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
TRUST_PROXY=1

# Database (PostgreSQL / Supabase)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=postgres
PGSSL=false

# Redis
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka (KRaft Mode - ZooKeeper-less Raft Consensus)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=dlm-logistics-service

# JWT Authentication
JWT_SECRET=your_jwt_secret_key
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DLM Logistics <no-reply@dlm-logistics.com>"
