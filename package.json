{
  "name": "dlm-backend",
  "version": "1.0.0",
  "description": "Distributed Logistics & Warehouse Management System Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "nodemon dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "live": "git checkout main && git pull origin main && git checkout production && git reset --hard main && git push origin production --force-with-lease && git checkout main",
    "db:init": "ts-node src/scripts/initDb.ts",
    "db:seed": "ts-node src/scripts/seedDb.ts",
    "db:reset": "ts-node src/scripts/resetDb.ts",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "nodemailer": "^9.0.5",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
